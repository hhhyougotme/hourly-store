# Keep source; ignore everything else at root
/*
!/.gitignore
!/README.md
!/LICENSE
!/hourly-store-backend/
!/hourly-store-frontend/

# Secrets & local config
**/application.yml
.env
.env.*

# Build / deps
**/target/
**/node_modules/
**/.idea/
**/*.iml
.DS_Store
Thumbs.db

# Frontend build output (rebuild with npm run build)
hourly-store-backend/src/main/resources/static/assets/
hourly-store-backend/src/main/resources/static/index.html
